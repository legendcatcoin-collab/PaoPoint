{
    "version": 2,
    "builds": [
        {
            "src": "**/*.html",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.css",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.js",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.json",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.{png,jpg,jpeg,gif,svg,ico,webp}",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/admin/(.*)",
            "dest": "/admin/index.html"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}
